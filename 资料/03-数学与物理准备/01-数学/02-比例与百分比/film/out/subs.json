[
 {
  "t0": 0.52,
  "t1": 2.38,
  "text": "先来一个小测验"
 },
 {
  "t0": 2.42,
  "t1": 8.62,
  "text": "两杯柠檬水。小杯：1 勺柠檬汁，加 3 勺水。大杯"
 },
 {
  "t0": 8.66,
  "t1": 11.89,
  "text": "2 勺柠檬汁，加 8 勺水"
 },
 {
  "t0": 12.51,
  "t1": 14.31,
  "text": "哪一杯更酸？"
 },
 {
  "t0": 15.07,
  "t1": 20.23,
  "text": "大杯的柠檬汁更多，好像更酸？先别急着回答"
 },
 {
  "t0": 20.45,
  "t1": 24.77,
  "text": "学完今天的比例和百分比，你就能一眼算出来"
 },
 {
  "t0": 28.29,
  "t1": 31.78,
  "text": "第一步：比例，就是“几份对几份”"
 },
 {
  "t0": 31.9,
  "t1": 37.03,
  "text": "小杯是 1 勺柠檬汁对 3 勺水，写作 1 比 3"
 },
 {
  "t0": 37.45,
  "t1": 40.88,
  "text": "想多做一些，味道不变，怎么办？"
 },
 {
  "t0": 41,
  "t1": 46.21,
  "text": "柠檬汁和水，一起乘 2：2 勺柠檬汁，6 勺水"
 },
 {
  "t0": 46.83,
  "t1": 50.47,
  "text": "2 比 6，和 1 比 3，是同一个味道"
 },
 {
  "t0": 50.89,
  "t1": 54.81,
  "text": "两边乘同一个数，比例就不变。这句话"
 },
 {
  "t0": 54.85,
  "t1": 56.72,
  "text": "是不是很耳熟？"
 },
 {
  "t0": 59.14,
  "t1": 61.82,
  "text": "第二步：按比例分东西"
 },
 {
  "t0": 61.94,
  "t1": 67.58,
  "text": "10 颗糖，哥哥和妹妹按 3 比 2 来分。各分几颗？"
 },
 {
  "t0": 68,
  "t1": 71.59,
  "text": "先数一共几份：3 加 2，是 5 份"
 },
 {
  "t0": 72.11,
  "t1": 75.37,
  "text": "10 颗糖分成 5 份，每份 2 颗"
 },
 {
  "t0": 76.19,
  "t1": 81.6,
  "text": "哥哥 3 份，就是 6 颗；妹妹 2 份，就是 4 颗。加起来"
 },
 {
  "t0": 81.64,
  "t1": 83.52,
  "text": "正好 10 颗"
 },
 {
  "t0": 86.04,
  "t1": 90.66,
  "text": "第三步：百分比，就是“每 100 份里，占几份”"
 },
 {
  "t0": 90.78,
  "t1": 95.32,
  "text": "这块底板上有 100 个格子。铺上 25 块"
 },
 {
  "t0": 95.36,
  "t1": 97.23,
  "text": "就是 25%"
 },
 {
  "t0": 98.05,
  "t1": 104.06,
  "text": "铺一半，50 块，是 50%；全部铺满，是 100%"
 },
 {
  "t0": 104.69,
  "t1": 108.53,
  "text": "25% 也可以说成：100 份里的 25 份"
 },
 {
  "t0": 108.57,
  "t1": 112.4,
  "text": "等于四分之一，也等于 0.25"
 },
 {
  "t0": 113.32,
  "t1": 116.67,
  "text": "记住：百分号，就是“除以 100”"
 },
 {
  "t0": 119.09,
  "t1": 122.2,
  "text": "第四步：求一个数的百分之几"
 },
 {
  "t0": 122.32,
  "t1": 128.23,
  "text": "一个书包 80 元，今天便宜 25%。能省多少钱？"
 },
 {
  "t0": 128.75,
  "t1": 135.2,
  "text": "25% 就是 0.25。80 乘 0.25，等于 20"
 },
 {
  "t0": 135.72,
  "t1": 138.54,
  "text": "省 20 元，只要付 60 元"
 },
 {
  "t0": 139.06,
  "t1": 143.15,
  "text": "口诀：部分，等于总数，乘以百分比"
 },
 {
  "t0": 145.57,
  "t1": 148.57,
  "text": "第五步：反过来，求总数"
 },
 {
  "t0": 148.69,
  "t1": 153.13,
  "text": "一本书，你读了 30%，正好是 60 页"
 },
 {
  "t0": 153.17,
  "t1": 155.02,
  "text": "全书有多少页？"
 },
 {
  "t0": 155.64,
  "t1": 161.23,
  "text": "用上节课的方法：60 等于总数，乘以 30%"
 },
 {
  "t0": 161.55,
  "t1": 167.05,
  "text": "两边同时除以 30%：总数等于 60 除以 0.3"
 },
 {
  "t0": 167.09,
  "t1": 168.89,
  "text": "等于 200 页"
 },
 {
  "t0": 169.43,
  "t1": 175.12,
  "text": "检查一下：200 页的 30%，是 60 页。对了！"
 },
 {
  "t0": 177.34,
  "t1": 179.63,
  "text": "最后，带走三句话"
 },
 {
  "t0": 179.75,
  "t1": 185.28,
  "text": "一，比例是几份对几份，两边乘同一个数，比例不变"
 },
 {
  "t0": 185.6,
  "t1": 188.92,
  "text": "二，百分比是每 100 份里占几份"
 },
 {
  "t0": 188.96,
  "t1": 191.4,
  "text": "百分号就是除以 100"
 },
 {
  "t0": 191.72,
  "t1": 196.98,
  "text": "三，部分等于总数乘以百分比；反过来，就用除法"
 },
 {
  "t0": 200.6,
  "t1": 203.13,
  "text": "回到开头的两杯柠檬水"
 },
 {
  "t0": 203.35,
  "t1": 208.2,
  "text": "小杯一共 4 勺，柠檬汁占 1 勺，是 25%"
 },
 {
  "t0": 208.72,
  "t1": 213.57,
  "text": "大杯一共 10 勺，柠檬汁占 2 勺，是 20%"
 },
 {
  "t0": 214.09,
  "t1": 218.91,
  "text": "所以，小杯更酸！比较的时候，要看占多少"
 },
 {
  "t0": 218.95,
  "t1": 220.75,
  "text": "不能只看有多少"
 }
]