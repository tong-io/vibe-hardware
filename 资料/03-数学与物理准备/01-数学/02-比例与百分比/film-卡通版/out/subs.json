[
 {
  "t0": 0.62,
  "t1": 2.48,
  "text": "先来一个小测验"
 },
 {
  "t0": 2.52,
  "t1": 8.72,
  "text": "两杯柠檬水。小杯：1 勺柠檬汁，加 3 勺水。大杯"
 },
 {
  "t0": 8.76,
  "t1": 11.98,
  "text": "2 勺柠檬汁，加 8 勺水"
 },
 {
  "t0": 12.6,
  "t1": 14.4,
  "text": "哪一杯更酸？"
 },
 {
  "t0": 15.17,
  "t1": 20.33,
  "text": "大杯的柠檬汁更多，好像更酸？先别急着回答"
 },
 {
  "t0": 20.55,
  "t1": 24.87,
  "text": "学完今天的比例和百分比，你就能一眼算出来"
 },
 {
  "t0": 28.74,
  "t1": 32.23,
  "text": "第一步：比例，就是“几份对几份”"
 },
 {
  "t0": 32.35,
  "t1": 37.48,
  "text": "小杯是 1 勺柠檬汁对 3 勺水，写作 1 比 3"
 },
 {
  "t0": 37.9,
  "t1": 41.33,
  "text": "想多做一些，味道不变，怎么办？"
 },
 {
  "t0": 41.45,
  "t1": 46.66,
  "text": "柠檬汁和水，一起乘 2：2 勺柠檬汁，6 勺水"
 },
 {
  "t0": 47.28,
  "t1": 50.93,
  "text": "2 比 6，和 1 比 3，是同一个味道"
 },
 {
  "t0": 51.35,
  "t1": 55.27,
  "text": "两边乘同一个数，比例就不变。这句话"
 },
 {
  "t0": 55.31,
  "t1": 57.18,
  "text": "是不是很耳熟？"
 },
 {
  "t0": 59.81,
  "t1": 62.49,
  "text": "第二步：按比例分东西"
 },
 {
  "t0": 62.61,
  "t1": 68.25,
  "text": "10 颗糖，哥哥和妹妹按 3 比 2 来分。各分几颗？"
 },
 {
  "t0": 68.67,
  "t1": 72.26,
  "text": "先数一共几份：3 加 2，是 5 份"
 },
 {
  "t0": 72.78,
  "t1": 76.04,
  "text": "10 颗糖分成 5 份，每份 2 颗"
 },
 {
  "t0": 76.66,
  "t1": 82.08,
  "text": "哥哥 3 份，就是 6 颗；妹妹 2 份，就是 4 颗。加起来"
 },
 {
  "t0": 82.12,
  "t1": 83.99,
  "text": "正好 10 颗"
 },
 {
  "t0": 87.13,
  "t1": 91.75,
  "text": "第三步：百分比，就是“每 100 份里，占几份”"
 },
 {
  "t0": 91.87,
  "t1": 96.44,
  "text": "这块板上有 100 个格子。涂上 25 格"
 },
 {
  "t0": 96.48,
  "t1": 98.28,
  "text": "就是 25%"
 },
 {
  "t0": 98.75,
  "t1": 104.73,
  "text": "涂一半，50 格，是 50%；全部涂满，是 100%"
 },
 {
  "t0": 105.35,
  "t1": 109.19,
  "text": "25% 也可以说成：100 份里的 25 份"
 },
 {
  "t0": 109.23,
  "t1": 113.07,
  "text": "等于四分之一，也等于 0.25"
 },
 {
  "t0": 113.89,
  "t1": 117.23,
  "text": "记住：百分号，就是“除以 100”"
 },
 {
  "t0": 120.35,
  "t1": 123.47,
  "text": "第四步：求一个数的百分之几"
 },
 {
  "t0": 123.59,
  "t1": 129.5,
  "text": "一个书包 80 元，今天便宜 25%。能省多少钱？"
 },
 {
  "t0": 130.02,
  "t1": 136.46,
  "text": "25% 就是 0.25。80 乘 0.25，等于 20"
 },
 {
  "t0": 136.98,
  "t1": 139.8,
  "text": "省 20 元，只要付 60 元"
 },
 {
  "t0": 140.32,
  "t1": 144.41,
  "text": "口诀：部分，等于总数，乘以百分比"
 },
 {
  "t0": 147.13,
  "t1": 150.14,
  "text": "第五步：反过来，求总数"
 },
 {
  "t0": 150.26,
  "t1": 154.7,
  "text": "一本书，你读了 30%，正好是 60 页"
 },
 {
  "t0": 154.74,
  "t1": 156.59,
  "text": "全书有多少页？"
 },
 {
  "t0": 157.11,
  "t1": 162.7,
  "text": "用上节课的方法：60 等于总数，乘以 30%"
 },
 {
  "t0": 163.02,
  "t1": 168.52,
  "text": "两边同时除以 30%：总数等于 60 除以 0.3"
 },
 {
  "t0": 168.56,
  "t1": 170.36,
  "text": "等于 200 页"
 },
 {
  "t0": 170.8,
  "t1": 176.49,
  "text": "检查一下：200 页的 30%，是 60 页。对了！"
 },
 {
  "t0": 178.78,
  "t1": 181.06,
  "text": "最后，带走三句话"
 },
 {
  "t0": 181.18,
  "t1": 186.71,
  "text": "一，比例是几份对几份，两边乘同一个数，比例不变"
 },
 {
  "t0": 187.03,
  "t1": 190.36,
  "text": "二，百分比是每 100 份里占几份"
 },
 {
  "t0": 190.4,
  "t1": 192.83,
  "text": "百分号就是除以 100"
 },
 {
  "t0": 193.15,
  "t1": 198.41,
  "text": "三，部分等于总数乘以百分比；反过来，就用除法"
 },
 {
  "t0": 202.25,
  "t1": 204.78,
  "text": "回到开头的两杯柠檬水"
 },
 {
  "t0": 204.9,
  "t1": 209.75,
  "text": "小杯一共 4 勺，柠檬汁占 1 勺，是 25%"
 },
 {
  "t0": 210.17,
  "t1": 215.02,
  "text": "大杯一共 10 勺，柠檬汁占 2 勺，是 20%"
 },
 {
  "t0": 215.44,
  "t1": 220.26,
  "text": "所以，小杯更酸！比较的时候，要看占多少"
 },
 {
  "t0": 220.3,
  "t1": 222.1,
  "text": "不能只看有多少"
 }
]