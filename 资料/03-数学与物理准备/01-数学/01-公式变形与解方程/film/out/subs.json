[
 {
  "t0": 0.62,
  "t1": 2.17,
  "text": "先来猜个谜"
 },
 {
  "t0": 2.21,
  "t1": 6.41,
  "text": "天平左边，放着一个盒子和 3 颗糖；右边"
 },
 {
  "t0": 6.45,
  "t1": 8.3,
  "text": "放着 7 颗糖"
 },
 {
  "t0": 8.42,
  "t1": 12.17,
  "text": "天平是平的。盒子里有几颗糖？"
 },
 {
  "t0": 13.09,
  "t1": 16.21,
  "text": "你可能一下就猜出来了：4 颗"
 },
 {
  "t0": 16.43,
  "t1": 21.65,
  "text": "恭喜，你刚刚解了一个方程！今天，我们把这种“猜”"
 },
 {
  "t0": 21.69,
  "t1": 23.96,
  "text": "变成一套谁都会的方法"
 },
 {
  "t0": 28.21,
  "t1": 31.25,
  "text": "第一步：等号，就是天平"
 },
 {
  "t0": 31.37,
  "t1": 35.61,
  "text": "我们把盒子里的糖数，叫做 x。这架天平"
 },
 {
  "t0": 35.65,
  "t1": 39.51,
  "text": "就可以写成：x 加 3 等于 7"
 },
 {
  "t0": 39.83,
  "t1": 43.12,
  "text": "等号的意思是：左右两边一样重"
 },
 {
  "t0": 43.16,
  "t1": 46.99,
  "text": "想知道 x，就得让盒子单独留在一边"
 },
 {
  "t0": 47.03,
  "t1": 51.84,
  "text": "要是只从右边拿走 3 颗呢？天平马上就歪了"
 },
 {
  "t0": 52.96,
  "t1": 56.96,
  "text": "所以，两边要一起拿：左边拿走 3 颗"
 },
 {
  "t0": 57,
  "t1": 58.97,
  "text": "右边也拿走 3 颗"
 },
 {
  "t0": 59.89,
  "t1": 65.19,
  "text": "天平还是平的。左边只剩盒子，右边剩 4 颗"
 },
 {
  "t0": 65.23,
  "t1": 67.03,
  "text": "x 等于 4"
 },
 {
  "t0": 67.37,
  "t1": 71.81,
  "text": "这就是整节课最重要的一句话：两边做同样的事"
 },
 {
  "t0": 71.85,
  "t1": 73.65,
  "text": "天平就不会歪"
 },
 {
  "t0": 76.42,
  "t1": 79.73,
  "text": "第二步：被减掉的，就加回来"
 },
 {
  "t0": 79.85,
  "t1": 84.81,
  "text": "一只小老鼠，从盒子里偷吃了 2 颗糖。剩下的"
 },
 {
  "t0": 84.85,
  "t1": 87.07,
  "text": "和右边 5 颗一样重"
 },
 {
  "t0": 87.79,
  "t1": 91.32,
  "text": "写出来就是：x 减 2 等于 5"
 },
 {
  "t0": 91.44,
  "t1": 95.69,
  "text": "盒子少了 2 颗，那就给两边，各放回 2 颗"
 },
 {
  "t0": 96.61,
  "t1": 101.67,
  "text": "左边又是完整的一盒；右边，5 加 2，是 7 颗"
 },
 {
  "t0": 101.71,
  "t1": 103.51,
  "text": "x 等于 7"
 },
 {
  "t0": 103.67,
  "t1": 108.11,
  "text": "你可能听过“移项要变号”：减 2 从左边跳到右边"
 },
 {
  "t0": 108.15,
  "t1": 109.95,
  "text": "就变成了加 2"
 },
 {
  "t0": 110.51,
  "t1": 113.88,
  "text": "它其实就是“两边同时加 2”的简写"
 },
 {
  "t0": 116.6,
  "t1": 120.03,
  "text": "第三步：乘了就除，除了就乘"
 },
 {
  "t0": 120.15,
  "t1": 123.25,
  "text": "现在左边有 3 个一模一样的盒子"
 },
 {
  "t0": 123.29,
  "t1": 125.21,
  "text": "右边是 12 颗糖"
 },
 {
  "t0": 125.53,
  "t1": 130.65,
  "text": "3 个 x，写作 3x，意思是 3 乘 x。所以"
 },
 {
  "t0": 130.69,
  "t1": 133.2,
  "text": "3x 等于 12"
 },
 {
  "t0": 133.32,
  "t1": 138.44,
  "text": "把两边都平均分成 3 份：一个盒子，对应 4 颗糖"
 },
 {
  "t0": 138.48,
  "t1": 140.28,
  "text": "x 等于 4"
 },
 {
  "t0": 141.03,
  "t1": 146.49,
  "text": "反过来：半个盒子，有 5 颗糖。也就是 x 除以 2"
 },
 {
  "t0": 146.53,
  "t1": 147.91,
  "text": "等于 5"
 },
 {
  "t0": 147.95,
  "t1": 152.23,
  "text": "两边都乘 2，凑回一整盒：x 等于 10"
 },
 {
  "t0": 155.17,
  "t1": 157.32,
  "text": "第四步：倒着拆"
 },
 {
  "t0": 157.44,
  "t1": 162.4,
  "text": "3 个盒子，再加 2 颗散糖，一共 14 颗。写成"
 },
 {
  "t0": 162.44,
  "t1": 165.44,
  "text": "3x 加 2 等于 14"
 },
 {
  "t0": 165.76,
  "t1": 170.67,
  "text": "这就像拆快递：最后包上的那一层，要最先拆开"
 },
 {
  "t0": 171.79,
  "t1": 176.7,
  "text": "先拿走散糖：两边减 2，得到 3x 等于 12"
 },
 {
  "t0": 177.42,
  "t1": 182.15,
  "text": "再平均分成 3 份：两边除以 3，x 等于 4"
 },
 {
  "t0": 182.86,
  "t1": 188.36,
  "text": "最后放回去检查：每盒 4 颗，3 盒 12 颗，加上 2 颗"
 },
 {
  "t0": 188.4,
  "t1": 190.91,
  "text": "正好 14。对了！"
 },
 {
  "t0": 193.74,
  "t1": 199.84,
  "text": "第五步：公式变形。公式，就是一架写好规则的天平"
 },
 {
  "t0": 199.96,
  "t1": 204.33,
  "text": "比如买东西：总价，等于单价，乘以数量"
 },
 {
  "t0": 204.65,
  "t1": 209.81,
  "text": "你买了 4 杯奶茶，一共花了 60 元。一杯多少钱？"
 },
 {
  "t0": 210.33,
  "t1": 214.11,
  "text": "单价被乘了 4，那就两边同时除以 4"
 },
 {
  "t0": 214.15,
  "t1": 218.03,
  "text": "单价等于 60 除以 4，等于 15 元"
 },
 {
  "t0": 218.75,
  "t1": 223.31,
  "text": "把数字换回文字：单价，等于总价除以数量"
 },
 {
  "t0": 223.35,
  "t1": 225.59,
  "text": "这就叫公式变形"
 },
 {
  "t0": 226.51,
  "t1": 230.03,
  "text": "公式里的文字和字母，就像盒子 x"
 },
 {
  "t0": 230.07,
  "t1": 232.01,
  "text": "只是还没打开的数"
 },
 {
  "t0": 234.49,
  "t1": 236.78,
  "text": "最后，带走三句话"
 },
 {
  "t0": 236.9,
  "t1": 239.11,
  "text": "一，等号是天平"
 },
 {
  "t0": 239.43,
  "t1": 243.69,
  "text": "二，两边做同样的事，让 x 单独留下"
 },
 {
  "t0": 244.01,
  "t1": 247.58,
  "text": "三，倒着拆，最后放回去检查"
 },
 {
  "t0": 251.53,
  "t1": 254.74,
  "text": "现在，打开开头那个盒子看看"
 },
 {
  "t0": 255.76,
  "t1": 261.22,
  "text": "果然，4 颗。下次遇到方程，你也能把盒子打开"
 }
]